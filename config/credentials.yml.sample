development:
  # Used as the base secret for all MessageVerifiers in Rails, including the one
  # protecting cookies; a new key can be generated via `bin/rails secret`.
  secret_key_base: [SECRET]

  # Finnhub API key (https://finnhub.io/dashboard)
  finnhub:
    api_key: [KEY]

  # SnapTrade Personal API key (https://snaptrade.com). A Personal key stands
  # for one person's own brokerage connections: there is no user to register and
  # no connection portal to run, so account calls send no userId/userSecret.
  # Connections are made on SnapTrade's site and picked up by
  # `bin/rails connections:discover`.
  snaptrade:
    client_id: [CLIENT_ID]
    consumer_key: [CONSUMER_KEY]

  # Plaid credentials (https://dashboard.plaid.com/developers/keys). `environment`
  # picks which Plaid to talk to: "sandbox" for the test institutions and made-up
  # data, "production" for real accounts — each has its own secret, so the secret
  # here has to be the one for the environment named.
  #
  # There is nothing to discover with these: Plaid has no endpoint that lists a
  # client_id's connections. Each one is made by running Plaid Link in the
  # browser (Connections → Connect Plaid), and the access token it produces is
  # kept on that connection's own `credentials` column, not here.
  plaid:
    environment: sandbox
    client_id: [CLIENT_ID]
    secret: [SECRET]

  # Password required to log in to the app.
  password: [PASSWORD]

test:
  secret_key_base: [SECRET]

  # Deliberately not a working key: the suite never makes a live call, and an
  # invalid one keeps it that way.
  finnhub:
    api_key: test-api-key

  snaptrade:
    client_id: test-client-id
    consumer_key: test-consumer-key

  plaid:
    environment: sandbox
    client_id: test-client-id
    secret: test-secret

  password: test-password
