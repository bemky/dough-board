<% total = accounts.sum(&:value) %>
<div>
    <div class="font-bold uppercase text-gray-500">Total Value</div>
    <div class="text-2xl font-bold mb-2"><%= number_to_currency total %></div>
    <% tiles = Treemap.layout(accounts, &:value) %>
    <% if tiles.empty? %>
        <p class="text-gray-500">No accounts with value</p>
    <% else %>
        <% colors = %w(bg-blue-500 bg-purple-500 bg-green-600 bg-yellow-600 bg-red-500 bg-gray-500) %>
        <div class="relative h-96 w-full rounded overflow-hidden">
            <% tiles.each_with_index do |tile, index| %>
                <%= link_to account_path(tile.item),
                        data: {tooltip: "#{tile.item.label}: #{number_to_currency tile.item.value}"},
                        class: "absolute overflow-hidden p-1 text-white leading-tight border border-white/40 #{colors[index % colors.length]}",
                        style: "left:#{tile.x}%; top:#{tile.y}%; width:#{tile.width}%; height:#{tile.height}%" do %>
                    <div class="text-xs font-bold truncate"><%= tile.item.label %></div>
                    <% if tile.width > 8 && tile.height > 10 %>
                        <div class="text-[10px] truncate"><%= number_to_currency tile.item.value %></div>
                    <% end %>
                <% end %>
            <% end %>
        </div>
    <% end %>
</div>
