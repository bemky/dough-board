<% total = accounts.sum(&:value) %>
<% tiles = Treemap.layout(accounts, &:value) %>
<section class="space-y-5">
    <div class="text-center">
        <div class="text-xs font-semibold uppercase tracking-widest text-muted">Total Value</div>
        <div class="mt-2"><%= display_amount total %></div>
    </div>

    <% if tiles.empty? %>
        <p class="text-center text-sm text-muted">No accounts with value</p>
    <% else %>
        <%= render partial: 'shared/treemap', locals: {cells: tiles.map { |tile|
            {x: tile.x, y: tile.y, width: tile.width, height: tile.height,
             label: tile.item.label, amount: tile.item.value, path: account_path(tile.item)}
        }} %>
    <% end %>
</section>
