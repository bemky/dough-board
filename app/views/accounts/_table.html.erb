<table class="w-full border-collapse">
    <thead>
        <tr class="border-b border-gray-200 text-left text-gray-500 text-sm">
            <th class="py-2 pr-4 font-semibold">Account</th>
            <th class="py-2 pr-4 font-semibold">Number</th>
            <th class="py-2 pr-4 font-semibold text-right">Holdings</th>
            <th class="py-2 font-semibold text-right">Value</th>
        </tr>
    </thead>
    <tbody>
    <% accounts.each do |account| %>
        <tr class="border-b border-gray-100">
            <td class="py-2 pr-4 font-semibold">
                <%= link_to account.label, account_path(account), class: "text-blue-600 hover:underline" %>
            </td>
            <td class="py-2 pr-4 text-gray-500"><%= account.number %></td>
            <td class="py-2 pr-4 text-right"><%= account.portfolio.count %></td>
            <td class="py-2 text-right"><%= number_to_currency account.value %></td>
        </tr>
    <% end %>
    </tbody>
</table>
<% if accounts.empty? %>
    <p class="text-gray-500 mt-4">No accounts</p>
<% end %>
