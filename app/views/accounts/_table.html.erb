<div class="table-scroll">
<table class="data-table">
    <thead>
        <tr>
            <th>Account</th>
            <th>Number</th>
            <th class="text-right">Holdings</th>
            <th class="text-right">Value</th>
        </tr>
    </thead>
    <tbody>
    <% accounts.each do |account| %>
        <tr>
            <td class="cell-primary">
                <%= link_to account.label, account_path(account), class: "hover:underline" %>
            </td>
            <td class="cell-secondary"><%= account.number %></td>
            <td class="cell-meta" data-label="Holdings:"><%= account.portfolio.count %></td>
            <td class="cell-amount"><%= number_to_currency account.value %></td>
        </tr>
    <% end %>
    </tbody>
</table>
</div>
<% if accounts.empty? %>
    <p class="mt-4 text-sm text-muted">No accounts</p>
<% end %>
