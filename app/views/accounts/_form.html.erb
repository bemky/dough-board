<% field_classes = "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" %>
<% label_classes = "block text-sm font-medium text-gray-700 mb-1" %>
<%= form_for account do |f| %>
    <%= hidden_field_tag "redirect_to", "/" %>
    <div class="space-y-4">
        <div>
            <%= f.label :name, class: label_classes %>
            <%= f.text_field :name, class: field_classes %>
        </div>
        <div>
            <%= f.label :institution_name, class: label_classes %>
            <%= f.text_field :institution_name, class: field_classes %>
        </div>
        <div>
            <%= f.label :number, class: label_classes %>
            <%= f.text_field :number, class: field_classes %>
        </div>
        <div>
            <%= f.label :positions_source, "Holdings", class: label_classes %>
            <%= f.select :positions_source, Account::POSITIONS_SOURCES.map { |value, label| [label, value] }, {}, class: field_classes %>
            <p class="mt-1 text-xs text-gray-500">
                Derived holdings are recomputed from this account's transactions on every run;
                hand-maintained ones are never rewritten.
            </p>
        </div>
        <button type="submit" class="inline-flex items-center justify-center rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
            <%= account.persisted? ? "Update Account" : "Create Account" %>
        </button>
    </div>
<% end %>
