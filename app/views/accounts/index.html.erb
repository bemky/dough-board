<div class="space-y-8">
    <div class="flex items-center justify-between gap-4">
        <h1 class="text-xl font-bold tracking-tight md:text-2xl">Accounts</h1>
        <%= link_to "New Account", new_account_path, class: "btn btn-primary btn-sm" %>
    </div>

    <%= render partial: 'accounts/treemap', locals: {accounts: @accounts} %>

    <section class="space-y-2">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">Accounts</h2>
        <%= render partial: 'accounts/table', locals: {accounts: @accounts} %>
    </section>
</div>
