<% show_account = local_assigns.fetch(:show_account, true) %>
<% empty_message = local_assigns.fetch(:empty_message, "No Transactions") %>
<% symbols = local_assigns.fetch(:symbols, []) %>
<% selected_symbols = local_assigns.fetch(:selected_symbols, []) %>
<%# Sorting and filtering, for a screen too narrow to show a header row. %>
<div class="mb-2 flex items-center justify-between gap-3 md:hidden">
    <%= sort_select [
        ["Newest first", :executed_at, "desc"],
        ["Oldest first", :executed_at, "asc"],
        ["Largest value", :value, "desc"],
        ["Symbol A–Z", "asset.symbol", "asc"]
    ] %>
    <%= render partial: 'transactions/symbol_filter', locals: {
        symbols: symbols, selected_symbols: selected_symbols, label: "Symbols"
    } %>
</div>
<div class="table-scroll">
<table class="data-table">
    <thead>
        <tr>
            <th><%= sort_header "Type", :type %></th>
            <th><%= sort_header "Execution", :executed_at %></th>
            <th>
                <div class="flex items-center gap-1">
                    <%= sort_header "Symbol", "asset.symbol" %>
                    <%= render partial: 'transactions/symbol_filter', locals: {
                        symbols: symbols, selected_symbols: selected_symbols
                    } %>
                </div>
            </th>
            <th><%= sort_header "Quantity", :quantity, align: :right, sub: "Split Adjusted" %></th>
            <th><%= sort_header "Value", :value, align: :right, sub: "At Execution" %></th>
            <% if show_account %>
                <th><%= sort_header "Account", "account.name" %></th>
            <% end %>
            <th></th>
        </tr>
    </thead>
    <tbody>
    <% transactions.each do |transaction| %>
        <tr>
            <td class="cell-secondary">
                <%# Green adds units, red removes them, gray moves cash rather than shares. %>
                <% type_color = {1 => "text-gain", -1 => "text-loss"}.fetch(Transaction::UNIT_SIGNS[transaction.type], "text-muted") %>
                <span class="text-xs font-bold uppercase tracking-wide <%= type_color %>"><%= transaction.type.tr("_", " ") %></span>
            </td>
            <td class="cell-detail"><%= transaction.executed_at.strftime("%b %d, %Y") %></td>
            <td class="cell-primary"><%= transaction.asset.symbol %></td>
            <td class="cell-meta" data-label="Qty">
                <%= transaction.quantity %>
                <%# The split-adjusted count is the header's second line, and a
                    phone has no header — so it stays on the desk. %>
                <span class="hidden text-xs text-muted md:inline"><%= transaction.adjusted_quantity %></span>
            </td>
            <td class="cell-amount"
                data-quote-symbol="<%= transaction.asset.symbol %>"
                data-quantity="<%= transaction.adjusted_quantity || transaction.quantity %>">
                <span data-quote-amount>
                    <% if transaction.cached_value %>
                        <%= number_to_currency transaction.cached_value %>
                    <% else %>
                        <span class="text-xs text-muted">Loading&hellip;</span>
                    <% end %>
                </span>
                <span class="block text-xs font-normal text-muted"><%= number_to_currency transaction.value %></span>
            </td>
            <% if show_account %>
                <td class="cell-caption"><%= link_to transaction.account.label, transaction.account, class: "hover:underline" %></td>
            <% end %>
            <td class="cell-action">
                <%= link_to "Edit", edit_transaction_path(transaction), class: "btn btn-secondary btn-sm" %>
            </td>
        </tr>
    <% end %>
    </tbody>
</table>
</div>
<% if transactions.empty? %>
    <p class="mt-4 text-sm text-muted"><%= empty_message %></p>
<% end %>
