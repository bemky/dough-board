<% show_account = local_assigns.fetch(:show_account, true) %>
<% empty_message = local_assigns.fetch(:empty_message, "No Transactions") %>
<% symbols = local_assigns.fetch(:symbols, []) %>
<% selected_symbols = local_assigns.fetch(:selected_symbols, []) %>
<table class="w-full border-collapse">
    <thead>
        <tr class="border-b border-gray-200 text-left text-gray-500 text-sm">
            <th class="py-2 pr-4"><%= sort_header "Type", :type %></th>
            <th class="py-2 pr-4"><%= sort_header "Execution", :executed_at %></th>
            <th class="py-2 pr-4">
                <div class="flex items-center gap-1">
                    <%= sort_header "Symbol", "asset.symbol" %>
                    <%= render partial: 'transactions/symbol_filter', locals: {
                        symbols: symbols, selected_symbols: selected_symbols
                    } %>
                </div>
            </th>
            <th class="py-2 pr-4"><%= sort_header "Quantity", :quantity, align: :right, sub: "Split Adjusted" %></th>
            <th class="py-2 pr-4"><%= sort_header "Value", :value, align: :right, sub: "At Execution" %></th>
            <% if show_account %>
                <th class="py-2 pr-4"><%= sort_header "Account", "account.name" %></th>
            <% end %>
            <th class="py-2 font-semibold"></th>
        </tr>
    </thead>
    <tbody>
    <% transactions.each do |transaction| %>
        <tr class="border-b border-gray-100">
            <td class="py-2 pr-4">
                <span class="uppercase text-xs font-bold <%= transaction.type == "buy" ? "text-green-600" : "text-red-600" %>"><%= transaction.type %></span>
            </td>
            <td class="py-2 pr-4"><%= transaction.executed_at.strftime("%b %d, %Y") %></td>
            <td class="py-2 pr-4"><%= transaction.asset.symbol %></td>
            <td class="py-2 pr-4 text-right">
                <%= transaction.quantity %>
                <span class="text-xs text-gray-500"><%= transaction.adjusted_quantity %></span>
            </td>
            <td class="py-2 pr-4 text-right">
                <%= number_to_currency transaction.current_value %>
                <span class="block text-xs text-gray-500"><%= number_to_currency transaction.value %></span>
            </td>
            <% if show_account %>
                <td class="py-2 pr-4"><%= link_to transaction.account.label, transaction.account, class: "text-blue-600 hover:underline" %></td>
            <% end %>
            <td class="py-2"><%= link_to "Edit", edit_transaction_path(transaction), class: "text-blue-600 hover:underline" %></td>
        </tr>
    <% end %>
    </tbody>
</table>
<% if transactions.empty? %>
    <p class="text-gray-500 mt-4"><%= empty_message %></p>
<% end %>
