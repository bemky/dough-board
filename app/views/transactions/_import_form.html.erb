<%= form_with url: import_transactions_path, method: :post, multipart: true, data: {dropzone_form: true} do |f| %>
    <div class="space-y-4">
        <div>
            <%= label_tag :account_id, "Account", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= select_tag :account_id, options_from_collection_for_select(Account.order(:provider, :name), :id, :label), include_blank: "Select account", class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" %>
        </div>
        <label data-dropzone class="flex flex-col items-center justify-center cursor-pointer rounded-md border-2 border-dashed border-gray-300 bg-white px-4 py-8 text-center text-sm text-gray-500 hover:border-blue-400 hover:bg-blue-50 transition-colors">
            <span data-dropzone-label>Drag &amp; drop a CSV here, or click to browse</span>
            <%= f.file_field :file, accept: ".csv,text/csv", class: "hidden", data: {dropzone_input: true} %>
        </label>
        <button type="submit" class="inline-flex w-full items-center justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
            Import
        </button>
    </div>
<% end %>
