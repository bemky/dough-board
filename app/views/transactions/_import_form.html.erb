<%= form_with url: import_transactions_path, method: :post, multipart: true, data: {dropzone_form: true} do |f| %>
    <div class="space-y-4">
        <div>
            <%= label_tag :account_id, "Account", class: "label" %>
            <%= select_tag :account_id, options_from_collection_for_select(Account.order(:institution_name, :name), :id, :label), include_blank: "Select account", class: "field" %>
        </div>
        <%# On a phone this is a tap target for the file picker; the drop half of
            it only ever comes up on a desk. %>
        <label data-dropzone class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-line bg-canvas px-4 py-8 text-center text-sm text-muted transition-colors hover:border-ink hover:text-ink">
            <span data-dropzone-label>Drag &amp; drop a CSV here, or click to browse</span>
            <%= f.file_field :file, accept: ".csv,text/csv", class: "hidden", data: {dropzone_input: true} %>
        </label>
        <%# Folded away by default: seven lines of column spec is most of a
            phone screen, and it is reference, not instruction. %>
        <details class="rounded-xl bg-canvas px-3 py-2 text-xs text-muted">
            <summary class="cursor-pointer py-1 font-semibold text-ink">Expected columns (header row required)</summary>
            <ul class="mt-1 space-y-1">
                <li><code class="font-mono text-ink">order_id</code> — broker's unique id; re-imports update the matching row</li>
                <li><code class="font-mono text-ink">symbol</code> — ticker, e.g. <span class="font-mono">AAPL</span></li>
                <li><code class="font-mono text-ink">side</code> — <span class="font-mono">buy</span>, <span class="font-mono">buy_to_open</span>, <span class="font-mono">sell</span>, or <span class="font-mono">sell_to_close</span></li>
                <li><code class="font-mono text-ink">fill_date</code> — when the order executed</li>
                <li><code class="font-mono text-ink">quantity</code> — shares/units</li>
                <li><code class="font-mono text-ink">gross_amount</code> — total dollar value</li>
                <li><code class="font-mono text-ink">asset_type</code> — optional; rows marked <span class="font-mono">option</span> are skipped</li>
            </ul>
        </details>
        <button type="submit" class="btn btn-primary w-full">
            Import
        </button>
    </div>
<% end %>
