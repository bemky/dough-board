<div class="space-y-8">
    <% if @account %>
        <%= render partial: 'accounts/header', locals: {account: @account, tab: :transactions} %>

        <%= render partial: 'transactions/table', locals: {
            transactions: @transactions,
            symbols: @symbols,
            selected_symbols: @selected_symbols,
            show_account: false,
            empty_message: "No transactions for this account."
        } %>

        <%= render partial: 'transactions/pagination', locals: {page: @page, per_page: @per_page, total_pages: @total_pages, total_count: @total_count} %>
    <% else %>
        <h1 class="text-xl font-bold tracking-tight md:text-2xl">Transactions</h1>

        <%# One column on a phone — the list, then the things you can add — and
            two on a desk, where a sidebar fits beside it. %>
        <div class="lg:flex lg:items-start lg:gap-8">
            <div class="min-w-0 lg:flex-1">
                <%= render partial: 'transactions/table', locals: {
                    transactions: @transactions,
                    symbols: @symbols,
                    selected_symbols: @selected_symbols
                } %>
                <%= render partial: 'transactions/pagination', locals: {page: @page, per_page: @per_page, total_pages: @total_pages, total_count: @total_count} %>
            </div>

            <div class="mt-10 space-y-6 lg:mt-0 lg:w-80 lg:shrink-0">
                <section id="add-transaction" class="card scroll-mt-20">
                    <h2 class="mb-4 text-base font-semibold">Add Transaction</h2>
                    <%= render partial: 'transactions/form', locals: {transaction: Transaction.new} %>
                </section>
                <section id="import-csv" class="card scroll-mt-20">
                    <h2 class="mb-4 text-base font-semibold">Import CSV</h2>
                    <%= render partial: 'transactions/import_form' %>
                </section>
            </div>
        </div>

        <%# The one action this page is for, kept in reach of a thumb. It sits
            above the tab bar, which owns the bottom of the screen. %>
        <div class="fixed inset-x-0 bottom-[calc(4.25rem+env(safe-area-inset-bottom))] z-20 px-4 md:hidden">
            <%= link_to "Add Transaction", "#add-transaction", class: "btn btn-primary w-full shadow-lg" %>
        </div>
    <% end %>
</div>
