<div class="pad-2x space-v-2x">
    <div class="">
        <div class="text-bold text-uppercase">
            Value
        </div>
        <div class="text-2x text-bold">
            <% total = @portfolio.sum{|x| x[:value]} %>
            <%= number_to_currency total %>
        </div>
        <div class="flex text-xs rounded overflow-hidden" style="gap: 1px;">
            <% colors = %w(blue purple green yellow red gray) %>
            <% @portfolio.each_with_index do |asset, index| %>
                <div data-tooltip="<%= asset[:symbol] %>: <%= number_to_currency asset[:value] %>" class="bg-<%= colors[index % colors.length] %> text-white" style="width:<%= (asset[:value] / total) * 100 %>%">
                    <%= asset[:symbol] %>
                </div>
            <% end %>
        </div>
    </div>
    <div class="flex gap-xl">
        <div class="flex-fill">
            <table class="uniformTable border-gray-20">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Execution</th>
                        <th></th>
                        <th class="text-right">
                            Quantity <br>
                            <span class="uniformLabel text-xs">Split Adjusted</span>
                        </th>
                        <th class="text-right">Value</th>
                        <th>Vendor</th>
                        <th></th>
                    </tr>
                </thead>
            <% @transactions.each do |transaction| %>
                <tr>
                    <td>
                        <span class="uniformLabel text-uppercase text-xs text-bold <%= transaction.type == "buy" ? "-green-60" : "-red" %>"><%= transaction.type %></span>
                    </td>
                    <td><%= transaction.executed_at.strftime("%b %d, %Y") %></td>
                    <td><%= transaction.asset.symbol %></td>
                    <td class="text-right">
                        <%= transaction.quantity %>
                        <span class="uniformLabel text-xs"><%= transaction.adjusted_quantity %></span>
                    </td>
                    <td class="text-right"><%= number_to_currency transaction.value %></td>
                    <td><%= transaction.vendor %></td>
                    <td><%= link_to "Edit", transaction %></td>
                </tr>
            <% end %>
            </table>
            <% if @transactions.length == 0 %>
            No Transactions
            <% end %>
        </div>
        <div class="rounded-xl bg-gray-10 pad-2x">
            <h3 class="margin-bottom">Add Transaction</h3>
            <%= render partial: 'transactions/form', locals: {transaction: Transaction.new} %>
        </div>
    </div>
</div>