<div class="p-8 space-y-8">
    <div>
        <div class="font-bold uppercase text-gray-500">
            Value
        </div>
        <div class="text-2xl font-bold">
            <% total = @portfolio.sum{|x| x[:value]} %>
            <%= number_to_currency total %>
        </div>
        <div class="flex text-xs rounded overflow-hidden mt-2 gap-px">
            <% colors = %w(bg-blue-500 bg-purple-500 bg-green-500 bg-yellow-500 bg-red-500 bg-gray-500) %>
            <% @portfolio.each_with_index do |asset, index| %>
                <div data-tooltip="<%= asset[:symbol] %>: <%= number_to_currency asset[:value] %>" tabindex="0" class="<%= colors[index % colors.length] %> text-white px-1 truncate" style="width:<%= total.zero? ? 0 : (asset[:value] / total) * 100 %>%">
                    <%= asset[:symbol] %>
                </div>
            <% end %>
        </div>
    </div>
    <div class="flex gap-8">
        <div class="flex-1">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="border-b border-gray-200 text-left text-gray-500 text-sm">
                        <th class="py-2 pr-4 font-semibold">Type</th>
                        <th class="py-2 pr-4 font-semibold">Execution</th>
                        <th class="py-2 pr-4 font-semibold"></th>
                        <th class="py-2 pr-4 font-semibold text-right">
                            Quantity <br>
                            <span class="text-xs font-normal">Split Adjusted</span>
                        </th>
                        <th class="py-2 pr-4 font-semibold text-right">
                            Value <br>
                            <span class="text-xs font-normal">At Execution</span>
                        </th>
                        <th class="py-2 pr-4 font-semibold">Account</th>
                        <th class="py-2 font-semibold"></th>
                    </tr>
                </thead>
                <tbody>
                <% @transactions.each do |transaction| %>
                    <tr class="border-b border-gray-100">
                        <td class="py-2 pr-4">
                            <span class="uppercase text-xs font-bold <%= transaction.type == "buy" ? "text-green-600" : "text-red-600" %>"><%= transaction.type %></span>
                        </td>
                        <td class="py-2 pr-4"><%= transaction.executed_at.strftime("%b %d, %Y") %></td>
                        <td class="py-2 pr-4"><%= transaction.asset.symbol %></td>
                        <td class="py-2 pr-4 text-right">
                            <%= transaction.quantity %>
                            <span class="text-xs text-gray-500"><%= transaction.adjusted_quantity %></span>
                        </td>
                        <td class="py-2 pr-4 text-right">
                            <%= number_to_currency transaction.current_value %>
                            <span class="block text-xs text-gray-500"><%= number_to_currency transaction.value %></span>
                        </td>
                        <td class="py-2 pr-4"><%= transaction.account.label %></td>
                        <td class="py-2"><%= link_to "Edit", transaction, class: "text-blue-600 hover:underline" %></td>
                    </tr>
                <% end %>
                </tbody>
            </table>
            <% if @transactions.length == 0 %>
                <p class="text-gray-500 mt-4">No Transactions</p>
            <% end %>
        </div>
        <div class="rounded-xl bg-gray-100 p-8 w-80 shrink-0">
            <h3 class="mb-4 text-lg font-semibold">Add Transaction</h3>
            <%= render partial: 'transactions/form', locals: {transaction: Transaction.new} %>
        </div>
    </div>
</div>
