<% first = total_count.zero? ? 0 : (page - 1) * per_page + 1 %>
<% last = [page * per_page, total_count].min %>
<%# Prev/Next are thumb-sized pills on their own row; the count and the per-page
    picker sit above them, and spread out onto one line on a desk. %>
<div class="mt-4 flex flex-col gap-4 border-t border-line pt-4 text-sm md:flex-row md:items-center md:justify-between">
    <div class="flex items-center justify-between gap-4 md:justify-start md:gap-6">
        <div class="text-muted">
            <%= "#{number_with_delimiter first}–#{number_with_delimiter last} of #{number_with_delimiter total_count}" %>
        </div>

        <%= form_with url: request.path, method: :get do %>
            <% params.fetch(:order, {}).each do |key, direction| %>
                <%= hidden_field_tag "order[#{key}]", direction, id: nil %>
            <% end %>
            <% Array(params[:symbols]).each do |symbol| %>
                <%= hidden_field_tag "symbols[]", symbol, id: nil %>
            <% end %>
            <div class="flex items-center gap-2">
                <%= label_tag :per_page, "Per page", class: "text-muted" %>
                <%= select_tag :per_page,
                    options_for_select(TransactionsController::PER_PAGE_OPTIONS, per_page),
                    data: {auto_submit: true},
                    class: "field h-11 w-auto py-2 pr-8 text-sm" %>
                <noscript>
                    <button type="submit" class="btn btn-secondary btn-sm">Apply</button>
                </noscript>
            </div>
        <% end %>
    </div>

    <div class="flex items-center justify-between gap-3">
        <% if page > 1 %>
            <%= link_to "← Prev", list_url(page: page - 1, per_page: per_page), class: "btn btn-secondary btn-sm flex-1 md:flex-none" %>
        <% else %>
            <span class="btn btn-secondary btn-sm flex-1 opacity-40 md:flex-none">← Prev</span>
        <% end %>
        <span class="whitespace-nowrap text-muted">Page <%= page %> of <%= total_pages %></span>
        <% if page < total_pages %>
            <%= link_to "Next →", list_url(page: page + 1, per_page: per_page), class: "btn btn-secondary btn-sm flex-1 md:flex-none" %>
        <% else %>
            <span class="btn btn-secondary btn-sm flex-1 opacity-40 md:flex-none">Next →</span>
        <% end %>
    </div>
</div>
