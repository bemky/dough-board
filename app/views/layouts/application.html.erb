<!DOCTYPE html>
<html>
  <head>
    <title>DoughBoard</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'boot', 'data-turbo-track': 'reload', defer: true %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased">
    <nav class="border-b border-gray-200 bg-white px-8">
      <div class="flex items-center justify-between gap-8">
        <div class="flex items-center gap-8">
          <%= link_to "DoughBoard", root_path, class: "font-bold" %>
          <% if session[:logged_in] %>
            <div class="flex gap-6">
              <%= nav_tab "Assets", assets_path, controller_name == "assets" %>
              <%= nav_tab "Accounts", accounts_path, controller_name == "accounts" %>
              <%= nav_tab "Transactions", transactions_path, controller_name == "transactions" %>
            </div>
          <% end %>
        </div>
        <% if session[:logged_in] %>
          <%= button_to "Log out", logout_path, method: :delete, class: "text-sm text-gray-500 hover:text-gray-700" %>
        <% end %>
      </div>
    </nav>
    <% if flash[:notice] %>
      <div class="bg-green-100 border-b border-green-200 px-8 py-3 text-sm text-green-800"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert] %>
      <div class="bg-red-100 border-b border-red-200 px-8 py-3 text-sm text-red-800"><%= flash[:alert] %></div>
    <% end %>
    <%= yield %>
  </body>
</html>
