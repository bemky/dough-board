<!DOCTYPE html>
<html>
  <head>
    <title>DoughBoard</title>
    <%# viewport-fit=cover so the bottom bar can sit under the home indicator
        and pad itself back out with the safe-area inset. %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#f5f4ef">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'tailwind', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'boot', 'data-turbo-track': 'reload', defer: true %>
  </head>

  <body class="min-h-screen bg-canvas text-ink antialiased">
    <header class="sticky top-0 z-30 border-b border-line bg-canvas/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-8">
        <%= link_to "DoughBoard", root_path, class: "text-base font-bold tracking-tight" %>

        <%# The full set of destinations, on a screen wide enough to hold them.
            On a phone they are the bar at the bottom of this file instead. %>
        <% if session[:logged_in] %>
          <nav class="hidden md:flex md:items-center md:gap-6">
            <% nav_destinations.each do |destination| %>
              <%= nav_tab destination[:title], destination[:path], destination[:active] %>
            <% end %>
          </nav>
          <%= button_to logout_path, method: :delete, class: "btn btn-secondary btn-sm" do %>
            Log out
          <% end %>
        <% end %>
      </div>
    </header>

    <% if flash[:notice] || flash[:alert] %>
      <div class="mx-auto max-w-6xl px-4 pt-4 md:px-8">
        <% if flash[:notice] %>
          <p class="rounded-xl border border-gain/30 bg-gain/10 px-4 py-3 text-sm text-gain"><%= flash[:notice] %></p>
        <% end %>
        <% if flash[:alert] %>
          <p class="rounded-xl border border-loss/30 bg-loss/10 px-4 py-3 text-sm text-loss"><%= flash[:alert] %></p>
        <% end %>
      </div>
    <% end %>

    <%# The bottom padding clears the tab bar; a phone's last row would sit
        under it otherwise. %>
    <main class="mx-auto max-w-6xl px-4 py-6 pb-28 md:px-8 md:py-10 md:pb-10">
      <%= yield %>
    </main>

    <% if session[:logged_in] %>
      <nav class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-canvas/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden">
        <div class="flex items-stretch justify-around">
          <% nav_destinations.each do |destination| %>
            <%= link_to destination[:path],
                  class: "flex flex-1 flex-col items-center gap-1 px-1 py-2 text-[11px] font-semibold #{destination[:active] ? "text-ink" : "text-muted"}" do %>
              <%= nav_icon destination[:icon] %>
              <span class="truncate"><%= destination[:short] %></span>
            <% end %>
          <% end %>
        </div>
      </nav>
    <% end %>
  </body>
</html>
