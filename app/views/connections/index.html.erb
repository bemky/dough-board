<div class="space-y-8">
    <div class="space-y-4">
        <div>
            <h1 class="text-xl font-bold tracking-tight md:text-2xl">Connections</h1>
            <p class="mt-1 max-w-2xl text-sm text-muted">
                Read-only links to an institution. Some providers are connected to on
                their own site and picked up here by Discover; others hand over one
                connection at a time through Connect.
            </p>
        </div>
        <%# Full-width buttons stacked on a phone, side by side once there's room. %>
        <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
            <% Connectors.discoverable.each do |connector| %>
                <%= button_to "Discover #{connector.titleize}", discover_connections_path(connector: connector),
                    form: {class: "w-full sm:w-auto"},
                    class: "btn btn-primary w-full sm:w-auto" %>
            <% end %>
            <%# One button per kind: a provider shows only the institutions that
                support everything asked of them, and a brokerage and a card
                issuer are rarely the same institution. %>
            <% Connectors.linkable.each do |connector| %>
                <% Connectors::Base::LINK_KINDS.each do |kind, label| %>
                    <%= link_to "Connect #{connector.titleize}: #{label}", link_connections_path(connector: connector, kind: kind),
                        class: "btn btn-primary w-full sm:w-auto" %>
                <% end %>
            <% end %>
        </div>
    </div>

    <%= render partial: 'connections/table', locals: {connections: @connections} %>
</div>
