<div class="mx-auto max-w-md space-y-6" data-plaid-link="<%= @link_token %>">
    <div>
        <h1 class="text-xl font-bold tracking-tight md:text-2xl">
            <% if @connection %>
                Reconnect <%= @connection.label %>
            <% else %>
                Connect a <%= Connectors::Base::LINK_KINDS[@kind] %>
            <% end %>
        </h1>
        <p class="mt-2 text-sm text-muted">
            <% if @connection %>
                <%= @connector.titleize %> needs you to sign in to this institution again
                before it can keep reading the account. Nothing else about the
                connection changes.
            <% else %>
                <%= @connector.titleize %> opens the institution's own sign-in. Dough Board
                never sees the credentials — only the read-only balances, holdings and
                amounts owed that come back afterward. Only institutions that can answer
                for a <%= Connectors::Base::LINK_KINDS[@kind] %> are offered; connect the
                other kind from the connections page separately.
            <% end %>
        </p>
    </div>

    <%= form_with url: complete_link_connections_path, method: :post, id: "plaid-link-form" do %>
        <%= hidden_field_tag :connector, @connector %>
        <%= hidden_field_tag :connection_id, @connection&.id %>
        <%# Filled in by the flow on success. An update-mode run leaves it blank:
            the credentials already on the connection start working again. %>
        <%= hidden_field_tag :public_token, nil, id: "plaid-public-token" %>
    <% end %>

    <div class="flex flex-col items-center gap-3 sm:flex-row">
        <button type="button" data-plaid-open disabled
            class="btn btn-primary w-full disabled:opacity-50 sm:w-auto">
            Open <%= @connector.titleize %>
        </button>
        <%= link_to "Cancel", connections_path, class: "btn btn-secondary w-full sm:w-auto" %>
    </div>

    <p class="text-sm text-muted" data-plaid-status>Opening&hellip;</p>
</div>
