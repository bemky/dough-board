<div class="table-scroll">
<table class="data-table">
    <thead>
        <tr>
            <th><%= sort_header "Institution", :financial_institution %></th>
            <th><%= sort_header "Connector", :connector %></th>
            <th class="text-right">Accounts</th>
            <th><%= sort_header "Last Sync", :synced_at %></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    <% connections.each do |connection| %>
        <tr>
            <td class="cell-primary">
                <span><%= connection.financial_institution.presence || "Unknown" %></span>
                <% if connection.disabled? %>
                    <span class="ml-1 rounded-full bg-loss/10 px-2 py-0.5 text-xs font-medium text-loss">disabled</span>
                <% end %>
                <% if connection.name.present? %>
                    <span class="block text-xs font-normal text-muted"><%= connection.name %></span>
                <% end %>
            </td>
            <td class="cell-secondary"><%= connection.connector %></td>
            <td class="cell-meta" data-label="Accounts:"><%= connection.accounts.size %></td>
            <td class="cell-detail">
                <% if connection.synced_at %>
                    Synced <%= time_ago_in_words(connection.synced_at) %> ago
                <% else %>
                    <span class="text-muted">Never</span>
                <% end %>
                <% if connection.last_error.present? %>
                    <span class="block text-xs text-loss" data-tooltip="<%= connection.last_error %>">Last sync failed</span>
                <% end %>
            </td>
            <td class="cell-action">
                <%# Signing in again is the only thing that fixes an expired
                    connection, so it leads when that's what's wrong. %>
                <% if connection.linkable? && connection.needs_reauthorization? %>
                    <%= link_to "Reconnect", link_connections_path(connection_id: connection.id),
                        class: "btn btn-danger btn-sm mr-1" %>
                <% end %>
                <%= button_to "Sync", sync_connection_path(connection),
                    form: {class: "inline"},
                    class: "btn btn-secondary btn-sm" %>
            </td>
        </tr>
    <% end %>
    </tbody>
</table>
</div>
<% if connections.empty? %>
    <p class="mt-4 text-sm text-muted">No connections yet. Connect an institution on the provider's site, then Discover.</p>
<% end %>
