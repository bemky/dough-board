<% field_classes = "field" %>
<% label_classes = "label" %>
<%= form_for position do |f| %>
    <%# Without this, standardapi's create redirects to #show. %>
    <%= hidden_field_tag "redirect_to", positions_path %>
    <div class="space-y-4">
        <% if position.errors.any? %>
            <div class="rounded-xl border border-loss/30 bg-loss/10 px-4 py-3 text-sm text-loss">
                <ul class="list-inside list-disc">
                    <% position.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                    <% end %>
                </ul>
            </div>
        <% end %>
        <div>
            <%= f.label :symbol, class: label_classes %>
            <%= f.text_field :symbol, value: position.symbol || position.asset&.symbol, class: field_classes %>
        </div>
        <div>
            <%= f.label :account_id, "Account", class: label_classes %>
            <%# Only accounts whose positions are maintained by hand: on any other,
                the next derivation would overwrite whatever is entered here. %>
            <% accounts = Account.where(positions_source: "manual").order(:institution_name, :name) %>
            <%= f.collection_select :account_id, accounts, :id, :label, { prompt: "Select account" }, class: field_classes %>
            <% if accounts.empty? %>
                <p class="hint">
                    No accounts keep positions by hand yet. Set an account's holdings to
                    &ldquo;Entered and maintained by hand&rdquo; to add positions to it.
                </p>
            <% end %>
            <%= link_to "+ Add account", new_account_path, class: "hint underline" %>
        </div>
        <div>
            <%= f.label :units, class: label_classes %>
            <%= f.number_field :units, step: 'any', class: field_classes %>
        </div>
        <div>
            <%= f.label :price, class: label_classes %>
            <%= f.number_field :price, step: '0.01', class: field_classes %>
            <p class="hint">Left blank, the holding is valued at the latest quote for its symbol.</p>
        </div>
        <div>
            <%= f.label :average_price, "Average Cost", class: label_classes %>
            <%= f.number_field :average_price, step: '0.01', class: field_classes %>
        </div>
        <button type="submit" class="btn btn-primary w-full md:w-auto">
            <%= position.persisted? ? "Save" : "Add" %>
        </button>
        <% if position.persisted? %>
            <%= button_to "Delete", position_path(position), method: :delete,
                form: {data: {turbo_confirm: "Delete this position?"}, class: "inline"},
                class: "btn btn-danger w-full md:w-auto" %>
        <% end %>
    </div>
<% end %>
