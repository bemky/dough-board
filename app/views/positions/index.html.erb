<div class="space-y-8">
    <% if @account %>
        <%= render partial: 'accounts/header', locals: {account: @account, tab: :positions} %>

        <div class="rounded-xl border border-line bg-surface px-4 py-3 text-sm text-muted">
            <span class="font-semibold text-ink">Holdings:</span> <%= @account.positions_source_description %><% if @account.derives_positions? %>, and rewritten on every run — edit the transactions, not these rows<% end %>.
        </div>

        <%= render partial: 'positions/table', locals: {
            positions: @positions,
            show_account: false,
            empty_message: "No positions for this account."
        } %>

        <% if @account.manual_positions? %>
            <section id="add-position" class="card scroll-mt-20 xl:max-w-md">
                <h2 class="mb-4 text-base font-semibold">Add Position</h2>
                <%= render partial: 'positions/form', locals: {position: Position.new(account: @account)} %>
            </section>
        <% end %>
    <% else %>
        <h1 class="text-xl font-bold tracking-tight md:text-2xl">Positions</h1>

        <div class="xl:flex xl:items-start xl:gap-8">
            <div class="min-w-0 xl:flex-1">
                <%= render partial: 'positions/table', locals: {positions: @positions} %>
            </div>

            <div class="mt-10 xl:mt-0 xl:w-80 xl:shrink-0">
                <section id="add-position" class="card scroll-mt-20">
                    <h2 class="mb-4 text-base font-semibold">Add Position</h2>
                    <%= render partial: 'positions/form', locals: {position: Position.new} %>
                </section>
            </div>
        </div>

        <div class="fixed inset-x-0 bottom-[calc(4.25rem+env(safe-area-inset-bottom))] z-20 px-4 md:hidden">
            <%= link_to "Add Position", "#add-position", class: "btn btn-primary w-full shadow-lg" %>
        </div>
    <% end %>
</div>
