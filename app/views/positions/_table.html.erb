<% show_account = local_assigns.fetch(:show_account, true) %>
<% empty_message = local_assigns.fetch(:empty_message, "No Positions") %>
<table class="w-full border-collapse">
    <thead>
        <tr class="border-b border-gray-200 text-left text-gray-500 text-sm">
            <th class="py-2 pr-4"><%= sort_header "Symbol", "asset.symbol" %></th>
            <% if show_account %>
                <th class="py-2 pr-4"><%= sort_header "Account", "account.name" %></th>
            <% end %>
            <th class="py-2 pr-4"><%= sort_header "Units", :units, align: :right %></th>
            <th class="py-2 pr-4"><%= sort_header "Price", :price, align: :right %></th>
            <th class="py-2 pr-4"><%= sort_header "Value", :value, align: :right %></th>
            <th class="py-2 pr-4"><%= sort_header "Cost Basis", :cost_basis, align: :right %></th>
            <th class="py-2"></th>
        </tr>
    </thead>
    <tbody>
    <% positions.each do |position| %>
        <tr class="border-b border-gray-100">
            <td class="py-2 pr-4 font-semibold"><%= position.asset.symbol %></td>
            <% if show_account %>
                <td class="py-2 pr-4"><%= link_to position.account.label, position.account, class: "text-blue-600 hover:underline" %></td>
            <% end %>
            <td class="py-2 pr-4 text-right"><%= position.units.round(4) %></td>
            <td class="py-2 pr-4 text-right"
                data-quote-symbol="<%= position.asset.symbol %>"
                data-quantity="<%= position.units %>">
                <% if position.price %>
                    <span data-quote-price><%= number_to_currency position.price %></span>
                <% else %>
                    <span class="text-xs text-gray-400" data-quote-price>Loading&hellip;</span>
                <% end %>
            </td>
            <td class="py-2 pr-4 text-right" data-quote-value>
                <%= position.value ? number_to_currency(position.value) : content_tag(:span, "&mdash;".html_safe, class: "text-gray-400") %>
            </td>
            <td class="py-2 pr-4 text-right text-gray-500">
                <%= position.cost_basis ? number_to_currency(position.cost_basis) : content_tag(:span, "&mdash;".html_safe, class: "text-gray-400") %>
            </td>
            <td class="py-2 text-right">
                <%# A derived account's snapshot is rewritten on every run, so an edit
                    to one of its rows would not survive; don't offer one. %>
                <% if position.editable? %>
                    <%= link_to "Edit", edit_position_path(position), class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-2.5 py-1 text-xs font-medium text-gray-700 hover:border-blue-400 hover:bg-blue-50 hover:text-blue-700" %>
                <% end %>
            </td>
        </tr>
    <% end %>
    </tbody>
</table>
<% if positions.empty? %>
    <p class="text-gray-500 mt-4"><%= empty_message %></p>
<% end %>
