<% show_account = local_assigns.fetch(:show_account, true) %>
<% empty_message = local_assigns.fetch(:empty_message, "No Positions") %>
<%# Sorting, for a screen too narrow to show a header row. %>
<div class="mb-2 md:hidden">
    <%= sort_select [
        ["Largest value", :value, "desc"],
        ["Smallest value", :value, "asc"],
        ["Symbol A–Z", "asset.symbol", "asc"],
        ["Most units", :units, "desc"]
    ] %>
</div>
<div class="table-scroll">
<table class="data-table">
    <thead>
        <tr>
            <th><%= sort_header "Symbol", "asset.symbol" %></th>
            <% if show_account %>
                <th><%= sort_header "Account", "account.name" %></th>
            <% end %>
            <th><%= sort_header "Units", :units, align: :right %></th>
            <th><%= sort_header "Price", :price, align: :right %></th>
            <th><%= sort_header "Value", :value, align: :right %></th>
            <th><%= sort_header "Cost Basis", :cost_basis, align: :right %></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    <% positions.each do |position| %>
        <%# Demo mode scales what's held, not what it's worth apiece — see
            app/lib/demo_mode.rb. Off, these are the position's own figures. %>
        <% units = DemoMode.scale(position.units, position.asset.symbol) %>
        <% value = DemoMode.scale(position.value, position.asset.symbol) %>
        <% cost_basis = DemoMode.scale(position.cost_basis, position.asset.symbol) %>
        <tr>
            <td class="cell-primary"><%= position.asset.symbol %></td>
            <% if show_account %>
                <td class="cell-caption"><%= link_to position.account.label, position.account, class: "hover:underline" %></td>
            <% end %>
            <td class="cell-secondary" data-label="Units"><%= units.round(4) %></td>
            <td class="cell-meta"
                data-quote-symbol="<%= position.asset.symbol %>"
                data-quantity="<%= units %>">
                <% if position.price %>
                    <span data-quote-price><%= number_to_currency position.price %></span>
                <% else %>
                    <span class="text-xs text-muted" data-quote-price>Loading&hellip;</span>
                <% end %>
            </td>
            <td class="cell-amount" data-quote-value>
                <%= value ? number_to_currency(value) : content_tag(:span, "&mdash;".html_safe, class: "text-muted") %>
            </td>
            <td class="cell-detail-amount" data-label="Cost">
                <%= cost_basis ? number_to_currency(cost_basis) : content_tag(:span, "&mdash;".html_safe, class: "text-muted") %>
            </td>
            <td class="cell-action">
                <%# A derived account's snapshot is rewritten on every run, so an edit
                    to one of its rows would not survive; don't offer one. %>
                <% if position.editable? %>
                    <%= link_to "Edit", edit_position_path(position), class: "btn btn-secondary btn-sm" %>
                <% end %>
            </td>
        </tr>
    <% end %>
    </tbody>
</table>
</div>
<% if positions.empty? %>
    <p class="mt-4 text-sm text-muted"><%= empty_message %></p>
<% end %>
