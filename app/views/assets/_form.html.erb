<% field_classes = "field" %>
<% label_classes = "label" %>
<%= form_for asset do |f| %>
    <div class="space-y-4">
        <% if asset.errors.any? %>
            <div class="rounded-xl border border-loss/30 bg-loss/10 px-4 py-3 text-sm text-loss">
                <ul class="list-inside list-disc">
                    <% asset.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                    <% end %>
                </ul>
            </div>
        <% end %>
        <div>
            <%= f.label :symbol, class: label_classes %>
            <%= f.text_field :symbol, class: field_classes %>
        </div>
        <div>
            <%= f.label :name, class: label_classes %>
            <%= f.text_field :name, class: field_classes %>
        </div>
        <div>
            <%= f.label :type, class: label_classes %>
            <%# "cash" is left out: the dollar asset is made and maintained by
                the sync. "liability" is offered, so a loan at a lender no
                connection reaches can still be kept by hand. %>
            <%= f.select :type, %w(stock fund crypto liability), {include_blank: true}, class: field_classes %>
            <p class="hint">
                Crypto is quoted as BINANCE:&lt;SYMBOL&gt;USDT. A liability is worth a dollar a
                unit and is held in negative units — what's owed.
            </p>
        </div>
        <div>
            <%= f.label :exchange, class: label_classes %>
            <%= f.collection_select :exchange_id, Exchange.order(:code), :id, :label, {include_blank: true}, class: field_classes %>
        </div>
        <button type="submit" class="btn btn-primary w-full md:w-auto">
            <%= asset.persisted? ? "Save" : "Add" %>
        </button>
    </div>
<% end %>
