<% empty_message = local_assigns.fetch(:empty_message, "No Assets") %>
<div class="table-scroll">
<table class="data-table">
    <thead>
        <tr>
            <th>Symbol</th>
            <th>Type</th>
            <th class="text-right">Units</th>
            <th class="text-right">Price</th>
            <th class="text-right">Value</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    <% portfolio.each do |holding| %>
        <tr>
            <td class="cell-primary"><%= holding[:symbol] %></td>
            <td class="cell-detail"><%= holding[:asset].type %></td>
            <td class="cell-secondary" data-label="Units"><%= holding[:units].round(4) %></td>
            <%# data-quantity is the JS's name for whatever the price multiplies by. %>
            <td class="cell-meta" data-quote-symbol="<%= holding[:symbol] %>" data-quantity="<%= holding[:units] %>">
                <% if holding[:price] %>
                    <span data-quote-price><%= number_to_currency(holding[:price]) %></span>
                <% else %>
                    <span class="text-xs text-muted" data-quote-price>Loading&hellip;</span>
                <% end %>
            </td>
            <td class="cell-amount" data-quote-value>
                <%= holding[:price] ? number_to_currency(holding[:value]) : content_tag(:span, "&mdash;".html_safe, class: "text-muted") %>
            </td>
            <td class="cell-action">
                <%= link_to "Edit", edit_asset_path(holding[:asset]), class: "btn btn-secondary btn-sm" %>
            </td>
        </tr>
    <% end %>
    </tbody>
</table>
</div>
<% if portfolio.empty? %>
    <p class="mt-4 text-sm text-muted"><%= empty_message %></p>
<% end %>
