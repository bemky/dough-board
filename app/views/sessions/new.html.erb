<% field_classes = "field" %>
<% label_classes = "label" %>
<div class="mx-auto mt-10 max-w-sm space-y-6">
    <h1 class="text-center text-2xl font-bold tracking-tight">Log in</h1>
    <%= form_tag login_path, method: :post do %>
        <%= hidden_field_tag :redirect_to, params[:redirect_to] %>
        <div class="space-y-4">
            <div>
                <%= label_tag :password, nil, class: label_classes %>
                <%= password_field_tag :password, nil, class: field_classes, autofocus: true %>
            </div>
            <button type="submit" class="btn btn-primary w-full">
                Log in
            </button>
        </div>
    <% end %>
</div>
