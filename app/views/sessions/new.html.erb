<% field_classes = "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" %>
<% label_classes = "block text-sm font-medium text-gray-700 mb-1" %>
<div class="mx-auto mt-16 max-w-sm px-8">
    <h1 class="mb-6 text-xl font-semibold">Log in</h1>
    <%= form_tag login_path, method: :post do %>
        <%= hidden_field_tag :redirect_to, params[:redirect_to] %>
        <div class="space-y-4">
            <div>
                <%= label_tag :password, nil, class: label_classes %>
                <%= password_field_tag :password, nil, class: field_classes, autofocus: true %>
            </div>
            <button type="submit" class="inline-flex items-center justify-center rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
                Log in
            </button>
        </div>
    <% end %>
</div>
